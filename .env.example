# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dhan Application Keys (Get these from Dhan Developer Portal)
# These are used to generate OAuth login links
DHAN_APP_ID=your_dhan_api_key
DHAN_APP_SECRET=your_dhan_api_secret
# Optional: enables AES-GCM encryption for stored Dhan access tokens.
TRADING_KEYS_ENCRYPTION_SECRET=change_this_to_a_long_random_secret

# Backend scanner account authentication. Prefer the *_FILE forms in Docker
# so PINs, tokens, TOTP seeds and encryption material are not stored here.
DHAN_DATA_CLIENT_ID=
DHAN_DATA_ACCESS_TOKEN=
DHAN_CREDENTIAL_ENCRYPTION_SECRET=
DHAN_SCANNER_PIN=
DHAN_SCANNER_TOTP_SECRET=
# DHAN_DATA_CLIENT_ID_FILE=/app/python-backend/runtime-data/bootstrap/dhan_client_id
# DHAN_DATA_ACCESS_TOKEN_FILE=/app/python-backend/runtime-data/bootstrap/dhan_access_token
# DHAN_CREDENTIAL_ENCRYPTION_SECRET_FILE=/app/python-backend/runtime-data/bootstrap/dhan_credential_key
# DHAN_SCANNER_PIN_FILE=/app/python-backend/runtime-data/bootstrap/dhan_pin
# DHAN_SCANNER_TOTP_SECRET_FILE=/app/python-backend/runtime-data/bootstrap/dhan_totp_secret
DHAN_AUTO_RENEW_BEFORE_MINUTES=240
DHAN_AUTO_RENEW_CHECK_SECONDS=900

# Executioner risk controls
EXECUTIONER_ALLOW_LIVE_ORDERS=0
EXECUTIONER_MAX_TRADE_VALUE_RUPEES=

# NIFTY market-structure monitor
# Records the front-month NIFTY future with MarketFeed.Full + dedicated 200-depth feed.
NIFTY_DEPTH_MONITOR_ENABLED=1
NIFTY_DEPTH_LEVEL=200
NIFTY_DEPTH_LATEST_SAVE_SECONDS=5
# Persist every packet by default for tick-by-tick/order-flow reconstruction.
NIFTY_DEPTH_PERSIST_EVERY_PACKET=1
NIFTY_DEPTH_RAW_WRITE_SECONDS=0
NIFTY_DEPTH_RECONNECT_SECONDS=5
NIFTY_DEPTH_FIRST_PACKET_TIMEOUT_SECONDS=20
NIFTY_DEPTH_IMBALANCE_SECONDS=30
NIFTY_LARGE_ORDER_THRESHOLD=300
NIFTY_LARGE_ORDER_HYSTERESIS=0.80
NIFTY_VOLUME_PROFILE_SAVE_SECONDS=300
NIFTY_OPTIONS_FEED_ENABLED=1
NIFTY_OPTIONS_STRIKES_EACH_SIDE=2
NIFTY_OPTIONS_PRICE_WAIT_SECONDS=180
NIFTY_DEPTH_CHARTS_ENABLED=1
NIFTY_DEPTH_CHART_INTERVAL_SECONDS=60
NIFTY_CHART_MAX_DEPTH_PACKETS=5000
NIFTY_CHART_MAX_FULL_PACKETS=1800
NIFTY_CHART_MAX_CVD_ROWS=5000
NIFTY_CHART_WINDOW_MINUTES=15
NIFTY_CHART_TIME_BIN_SECONDS=5
NIFTY_CHART_PRICE_STEP=1
NIFTY_CHART_FOOTPRINT_MINUTES=1
NIFTY_CHART_DOM_LEVELS=48
NIFTY_LARGE_ORDER_CONFIRM_UPDATES=3
NIFTY_LARGE_ORDER_REMOVAL_UPDATES=3
NIFTY_OPTION_CHAIN_CHART_STRIKES_EACH_SIDE=5
# Optional override if the security master cannot resolve the front-month future.
NIFTY_DEPTH_SECURITY_ID=
NIFTY_DEPTH_DISPLAY_NAME=NIFTY FUT OVERRIDE
# Disabled by default to keep the monitor container focused on NIFTY depth capture.
MONITOR_LEGACY_LIQUIDITY_ENABLED=0

# Universe Scanner and Intra-Finder
UNIVERSE_SCANNER_BUILD_INTRADAY_BASELINES=1
INTRA_FINDER_SHADOW_MODE=1
TRADING_AMOUNT_MAX_AGE_SECONDS=2592000
INTRA_FINDER_INDICATOR_AGGREGATION_SECONDS=60
INTRA_FINDER_INDICATOR_EVENT_COOLDOWN_SECONDS=600
INTRA_FINDER_STOCK_AGENT_COOLDOWN_SECONDS=1200
INTRA_FINDER_INDICATOR_VOLUME_SURGE_RATIO=1.8
INTRA_FINDER_INDICATOR_MAX_EVENT_LAG_SECONDS=60
# Trade-readiness is intentionally conservative. Indicator observations are
# watched for confirmation; they do not directly start an AI agent.
INTRA_FINDER_READINESS_SCORE_THRESHOLD=75
INTRA_FINDER_READINESS_DIRECTION_MARGIN=10
INTRA_FINDER_READINESS_MIN_COMPLETED_BARS=45
INTRA_FINDER_READINESS_MIN_ROOM_ATR=0.55
INTRA_FINDER_READINESS_MAX_LAST_TRADE_AGE_SECONDS=90
INTRA_FINDER_READINESS_OBSERVATION_SECONDS=600
INTRA_FINDER_READINESS_REEVALUATION_SECONDS=60
INTRA_FINDER_READINESS_MIN_CONFIRMATION_SECONDS=300
INTRA_FINDER_READINESS_MAX_ENTRY_DRIFT_ATR=0.80
AI_TRADING_BACKEND_URL_INTERNAL=http://ai-trading-agents:8020
# Public URL used only by Vercel's server routes in production. For local
# development, leave this unset to use the repository's file-based fallback.
# AI_TRADING_BACKEND_URL=https://api.polycognition.online
# Required on the Python gateway and internal Docker services. Vercel forwards
# each signed-in user's Supabase access token instead; never expose this value
# through a NEXT_PUBLIC_* variable.
AI_TRADING_BACKEND_TOKEN=replace_with_at_least_32_random_bytes
AI_TRADING_BACKEND_TIMEOUT_MS=10000
# Optional key separation. If unset, AI_TRADING_BACKEND_TOKEN also signs the
# one-time WebSocket tickets, which keeps the minimum setup to one app secret.
AI_TRADING_WS_SIGNING_SECRET=
AI_TRADING_WS_TICKET_TTL_SECONDS=45
# The Python gateway verifies user tokens with Supabase Auth and briefly caches
# the resulting user identity to avoid an upstream lookup on every status poll.
SUPABASE_AUTH_TIMEOUT_SECONDS=5
SUPABASE_AUTH_CACHE_SECONDS=30
AI_TRADING_ALLOWED_ORIGINS=http://localhost:3000,https://www.polycognition.online
# Browser-visible URL only; this is safe because it contains no credential.
NEXT_PUBLIC_AI_TRADING_WS_URL=ws://localhost:8020/ai-trading/stream
# Remotely-managed Cloudflare Tunnel connector token. Keep it out of Git.
CLOUDFLARE_TUNNEL_TOKEN=
SUPERVISOR_TRADE_MODE=auto
SUPERVISOR_TRADE_AMOUNT=
# Deprecated: regime analysis is disabled and no longer supplied to stock agents.
SUPERVISOR_REGIME_ANALYSIS_ENABLED=0
REGIME_ANALYSIS_USE_AGNO=0
MARKET_CALENDAR_NSE_SYNC_ENABLED=1
MARKET_CALENDAR_NSE_TIMEOUT_SECONDS=8
MARKET_HOLIDAY_DATES=
MARKET_FORCE_OPEN=0
MARKET_FORCE_CLOSED=0

# Command Code CLI settings for stock/risk analyzer lanes on Go plan
COMMAND_CODE_API_KEY=your_command_code_api_key
COMMAND_CODE_CLI_MODEL_ID=deepseek/deepseek-v4-pro
# Optional on Windows if PATH does not expose command-code/cmdc:
# COMMAND_CODE_CLI_PATH=C:\Users\your-user\AppData\Roaming\npm\command-code.cmd
COMMAND_CODE_CLI_MAX_TURNS=10
COMMAND_CODE_CLI_TIMEOUT_SECONDS=300
COMMAND_CODE_CLI_DISABLE_TELEMETRY=1

# OpenRouter model settings for Agno trading agents
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_MULTIMODAL_MODEL_ID=xiaomi/mimo-v2.5
REGIME_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_ENABLE_REASONING=1

# Supabase Storage for AI trade session artifacts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_TRADE_SESSIONS_BUCKET=trade-sessions
SUPABASE_URL=your_supabase_url

# Native Agno session persistence in Supabase Postgres.
# For the long-running Python container, use Supabase's Session Pooler URL (port 5432).
SUPABASE_DB_URL=postgresql://postgres.project_ref:password@pooler_host:5432/postgres
AGNO_DB_SCHEMA=public
AGNO_SESSION_TABLE=agno_sessions

# Convex is canonical for trading configuration and receives a complete mirror
# of every Agno session/run. Keep the admin key server-side (never NEXT_PUBLIC_).
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=dev:your-deployment|your_deployment_key
CONVEX_ADMIN_KEY=your_deployment_admin_key
CONVEX_REQUIRED=1
