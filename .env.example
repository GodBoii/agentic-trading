# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dhan Application Keys (Get these from Dhan Developer Portal)
# These are used to generate OAuth login links
DHAN_APP_ID=your_dhan_api_key
DHAN_APP_SECRET=your_dhan_api_secret
# Optional: enables AES-GCM encryption for stored Dhan access tokens.
TRADING_KEYS_ENCRYPTION_SECRET=change_this_to_a_long_random_secret

# Executioner risk controls
EXECUTIONER_ALLOW_LIVE_ORDERS=0
EXECUTIONER_MAX_TRADE_VALUE_RUPEES=

# Command Code CLI settings for stock/risk analyzer lanes on Go plan
COMMAND_CODE_API_KEY=your_command_code_api_key
COMMAND_CODE_CLI_MODEL_ID=deepseek/deepseek-v4-pro
# Optional on Windows if PATH does not expose command-code/cmdc:
# COMMAND_CODE_CLI_PATH=C:\Users\your-user\AppData\Roaming\npm\command-code.cmd
COMMAND_CODE_CLI_MAX_TURNS=10
COMMAND_CODE_CLI_TIMEOUT_SECONDS=300
COMMAND_CODE_CLI_DISABLE_TELEMETRY=1

# OpenRouter model settings for Agno trading agents
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TEXT_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_MULTIMODAL_MODEL_ID=xiaomi/mimo-v2.5
REGIME_MODEL_ID=deepseek/deepseek-v4-pro
OPENROUTER_ENABLE_REASONING=1

# Supabase Storage for AI trade session artifacts
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_TRADE_SESSIONS_BUCKET=trade-sessions
